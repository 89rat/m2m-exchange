{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://m2m.exchange/schemas/v1/common.json",
  "title": "M2M/1 common types",
  "$defs": {
    "EvmAddress": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$",
      "description": "EIP-55 checksummed or lowercase EVM address."
    },
    "BaseUnitAmount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "description": "Unsigned integer decimal string in asset base units. No floats, no signs."
    },
    "UnixSeconds": {
      "type": "integer",
      "minimum": 0,
      "description": "Seconds since Unix epoch (UTC)."
    },
    "MoneyAmount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "asset", "network"],
      "properties": {
        "amount": { "$ref": "#/$defs/BaseUnitAmount" },
        "asset": { "$ref": "#/$defs/EvmAddress", "description": "ERC-20 contract address." },
        "network": {
          "type": "string",
          "minLength": 1,
          "description": "x402 network string, e.g. \"base-sepolia\"."
        }
      }
    },
    "ResourceId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,62}$",
      "description": "serviceId / quoteId / orderId / receiptId."
    }
  }
}
